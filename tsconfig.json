{
  "compilerOptions": {
    "module": "esnext",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir":"src",
    "allowImportingTsExtensions":false
  },
  "include":["src/**/*"],
  "exclude": ["node_modules","dist"]
}